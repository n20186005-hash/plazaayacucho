---
import '../styles/global.css';

const origin = Astro.site ? Astro.site.origin : 'https://plazaayacucho.com';
const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site).toString() : `${origin}${pathname}`;

const siteDomain = 'plazaayacucho.com';
const attractionFullName = 'Plaza Mayor de Ayacucho';
const attractionShortName = 'Plaza Mayor de Ayacucho';
const attractionLocalName = 'Plaza Mayor de Huamanga';
const cityName = 'Ayacucho';
const stateProvince = 'Ayacucho';
const countryName = 'Perú';
const countryCode = 'PE';
const postalCode = '05003';
const mapsPhone = '+51 985 928 260';
const mapsPhoneHref = '+51985928260';
const latitude = -13.1603789;
const longitude = -74.2257816;

const mapUrl = 'https://maps.app.goo.gl/LoXftb7yUhBJUgCr9';
const minceturUrl = 'https://consultasenlinea.mincetur.gob.pe/fichaInventario/index.aspx?cod_Ficha=386';
const promperuUrl = 'https://target2.promperu.gob.pe/destinos/ayacucho/ciudad-de-ayacucho/plaza-mayor-de-la-ciudad-de-ayacucho';
const commonsUrl = 'https://commons.wikimedia.org/wiki/Ayacucho';

const localHero = `${origin}/images/plaza-mayor-huamanga-wide.jpg`;
const localPlaza = `${origin}/images/plaza-mayor-huamanga-wide.jpg`;
const localCathedral = `${origin}/images/catedral-ayacucho.jpg`;
const ogImage = localHero;
const ogImageAlt = `${attractionFullName} (${attractionLocalName}) — vista principal en ${cityName}, ${countryName}`;

const pageTitle = 'Plaza de Armas de Ayacucho: Plaza Mayor, ubicación y visita';
const pageDescription = 'Visita la Plaza Mayor de Ayacucho o Plaza de Armas: ubicación, portales, monumento a Sucre, horarios atribuidos y cómo distinguir los paseos urbanos de Wari y Quinua.';

const photos = {
  hero: '/images/plaza-mayor-huamanga-wide.jpg',
  plaza: '/images/plaza-mayor-huamanga-wide.jpg',
  cathedral: '/images/catedral-ayacucho.jpg',
  monument: '/images/plaza-armas-monumento.jpg'
};

const faq = [
  {
    q: '¿La Plaza Mayor de Huamanga cobra entrada?',
    a: 'No. La ficha de inventario turístico de MINCETUR registra el ingreso como libre. Las iglesias, museos o actividades cercanas pueden tener condiciones propias.'
  },
  {
    q: '¿Cuál es el mejor horario para visitar la plaza?',
    a: 'MINCETUR recomienda la visita entre las 06:00 y las 21:00 durante todo el año. Para fotografía y una caminata más tranquila, la primera hora de la mañana y el final de la tarde suelen ser las franjas más agradables.'
  },
  {
    q: '¿Cuánto tiempo conviene quedarse?',
    a: 'Para recorrer la plaza, observar sus portales y hacer fotografías, reserve aproximadamente 45–90 minutos. Si añade la Catedral, Santo Domingo, museos y una comida en el centro histórico, conviene dedicar 2–3 horas o más.'
  },
  {
    q: '¿Cómo llego desde el aeropuerto de Ayacucho?',
    a: 'La ficha oficial de MINCETUR indica aproximadamente 2,8 km desde el Aeropuerto Coronel FAP Alfredo Mendívil Duarte, con una referencia de unos 7 minutos en taxi, una estimación de la ficha y no una duración garantizada.'
  },
  {
    q: '¿Hay estacionamiento dentro de la Plaza Mayor?',
    a: 'No cuente con un cupo junto a la plaza sin confirmarlo. MINCETUR registra estacionamiento en la ciudad; no se ha verificado aquí una cochera concreta, sus tarifas ni disponibilidad.'
  },
  {
    q: '¿Por qué también se llama Plaza Mayor de Huamanga?',
    a: 'MINCETUR denomina al recurso Plaza Mayor de Ayacucho y explica sus nombres históricos Plaza Mayor de Huamanga y Plaza de Armas. Las tres expresiones ayudan a identificar el mismo espacio, no tres plazas distintas.'
  },
  {
    q: `¿Dónde se ubica exactamente ${attractionFullName}?`,
    a: `${attractionFullName} se ubica en el centro histórico de ${cityName}, región ${stateProvince}, ${countryName}, con código postal ${postalCode}. Sus coordenadas aproximadas son ${latitude}, ${longitude}.`
  },
  {
    q: `¿Qué relación tiene plazaayacucho.com con ${attractionShortName}?`,
    a: `plazaayacucho.com es una guía informativa e independiente dedicada a ${attractionFullName} (${attractionLocalName}). Esta web no representa a ninguna entidad pública y atribuye sus datos a las fuentes consultadas; para condiciones actuales remite a los canales oficiales.`
  },
  {
    q: `¿Qué hacer en la ${attractionShortName}?`,
    a: `Camine bajo los cuatro portales (Unión, Constitución, Independencia y Municipal), fotografíe los balcones de madera y la fachada de la Catedral, recorra los jardines y el monumento a Sucre, y visite el Templo de Santo Domingo y el Museo de Arte Popular Joaquín López Antay (retablos ayacuchanos). Los portales también concentran cafés y restaurantes para una pausa con vista al conjunto.`
  },
  {
    q: `¿Qué lugares turísticos hay cerca de la plaza en ${cityName}?`,
    a: `La Catedral está junto a la plaza y Santo Domingo y el Arco del Triunfo son visitas urbanas separadas. Wari y Quinua corresponden a excursiones regionales: organiza transporte y tiempo por separado, sin presentarlas como un paseo a pie desde la plaza.`
  },
  {
    q: `¿Cuándo se celebra la Semana Santa de ${cityName}?`,
    a: `Ayacucho es reconocida por su Semana Santa, una de las más famosas del Perú, que se celebra en marzo o abril (fechas móviles según el calendario litúrgico). Las procesiones suelen partir de la Catedral y recorrer el centro histórico. Si visita la plaza en esas fechas, espere mayor afluencia, controles de tránsito y horarios especiales; conviene confirmar el programa oficial antes de ir.`
  },
  {
    q: `¿Cómo llegar a la ${attractionShortName}?`,
    a: `En taxi desde el Aeropuerto Coronel FAP Alfredo Mendívil Duarte son aprox. 2,8 km (unos 7 min en condiciones favorables, según MINCETUR); desde el Terminal Terrestre Los Libertadores, aprox. 3,6 km (unos 12 min). Si ya está en el casco histórico, lo mejor es caminar: la plaza funciona como punto de orientación para templos, restaurantes y comercios.`
  },
  {
    q: `¿Qué es la ${attractionLocalName}?`,
    a: `${attractionLocalName} es la forma histórica con la que también se identifica a la ${attractionShortName}. Huamanga fue el nombre histórico de la ciudad antes de denominarse Ayacucho, de modo que ambas expresiones pueden aparecer juntas en material turístico y patrimonial.`
  },
  { q: '¿Qué horarios y contacto muestra Google Maps?', a: 'Consulta del 29 de octubre de 2026: 4,5/5 y 19.802 reseñas de terceros; la ficha muestra apertura el viernes a las 08:00 y el teléfono +51 985 928 260. No se ha confirmado que ese teléfono sea de la administración de la plaza ni que ese horario regule todo el espacio público. MINCETUR publica una franja de visita de 06:00 a 21:00; confirma tu fecha y los recintos que quieres visitar.' }
];

const attractionLd = {
  '@context': 'https://schema.org',
  "@type": 'TouristAttraction',
  "@id": `${origin}/#attraction`,
  name: attractionFullName,
  alternateName: [attractionLocalName, 'Plaza de Armas de Ayacucho', `${cityName} ${attractionFullName}`],
  description: `Guía completa del visitante de ${attractionFullName} (${attractionLocalName}) en ${cityName}, ${stateProvince}, ${countryName}.`,
  url: canonical || origin,
  mainEntityOfPage: { "@type": 'WebPage', "@id": canonical || origin },
  image: [localHero, localPlaza, localCathedral],
  "isAccessibleForFree": true,
  priceRange: 'Ingreso libre',
  address: {
    "@type": 'PostalAddress',
    streetAddress: attractionFullName,
    addressLocality: cityName,
    addressRegion: stateProvince,
    postalCode,
    addressCountry: countryCode
  },
  geo: {
    "@type": 'GeoCoordinates',
    latitude,
    longitude
  },
  "hasMap": mapUrl,
  sameAs: [mapUrl, minceturUrl, promperuUrl],
  containedInPlace: {
    "@type": 'City',
    name: cityName,
    containedInPlace: {
      "@type": 'AdministrativeArea',
      name: stateProvince,
      containedInPlace: { "@type": 'Country', name: countryName }
    }
  }
};

const faqLd = {
  '@context': 'https://schema.org',
  "@type": 'FAQPage',
  mainEntity: faq.map((item) => ({
    "@type": 'Question',
    name: item.q,
    acceptedAnswer: {
      "@type": 'Answer',
      text: item.a
    }
  }))
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  "@type": 'BreadcrumbList',
  itemListElement: [{ "@type": 'ListItem', position: 1, name: attractionFullName, item: origin }]
};
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#6f2e25" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-PE" href={origin + '/'} />
    <link rel="alternate" hreflang="x-default" href={origin + '/'} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Plaza Ayacucho" />
    <meta name="application-name" content="Plaza Ayacucho" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icons/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:site_name" content="Plaza Ayacucho" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={`${attractionShortName} (${attractionLocalName}) — qué hacer, cómo llegar e historia en ${cityName}`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${attractionShortName} (${attractionLocalName}) — guía en ${cityName}, ${countryName}`} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a href="#inicio" class="brand" aria-label={`Inicio — ${attractionFullName} (${attractionLocalName})`}>
          <img src="/icons/logo.svg" alt={`${attractionFullName} (${attractionLocalName})`} width="186" height="52" />
          <span class="brand-name"><b>{attractionFullName}</b><small>{attractionLocalName} · {cityName}, {countryName}</small></span>
        </a>
        <nav class="main-nav" aria-label="Navegación principal">
          <a href="#sobre">Sobre</a>
          <a href="#historia">Historia</a>
          <a href="#planifica">Planifica</a>
          <a href="#que-hacer">Qué hacer</a>
          <a href="#alrededores">Alrededores</a>
          <a href="#lugares">Lugares</a>
          <a href="#mapa">Mapa</a>
          <a href="#faq">FAQ</a>
        </nav>
        <a class="map-button" href={mapUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
      </div>
    </header>

    <main id="contenido">
      <section id="inicio" class="hero" style={`--hero-image: url('${photos.hero}')`}>
        <div class="hero-overlay"></div>
        <div class="shell hero-layout">
          <div class="hero-copy">
            <div class="eyebrow-row">
              <span>Ayacucho · Perú</span>
              <span>2.752 m s. n. m.</span>
              <span>Centro histórico de Huamanga</span>
            </div>
            <p class="hero-kicker">{attractionFullName}</p>
            <h1>Plaza de Armas de Ayacucho <span class="h1-sub">({attractionLocalName}, {cityName})</span></h1>
            <p class="hero-tagline">El corazón de piedra, arcos y memoria de Ayacucho</p>
            <p class="hero-lead">Bienvenido a <strong>{attractionFullName}</strong>, también identificada históricamente como <strong>{attractionLocalName}</strong>. Situada en el corazón de <strong>{cityName}</strong>, <strong>Región de {stateProvince}</strong>, <strong>{countryName}</strong>, esta plaza es el punto de partida principal para explorar la ciudad y su centro histórico.</p>
            <div class="hero-actions">
              <a class="button button-gold" href="#planifica">Planificar visita</a>
              <a class="button button-ghost" href="#fuentes">Ver fuentes de la guía</a>
            </div>
          </div>

          <aside class="fact-card" aria-label="Datos rápidos">
            <p class="card-label">Antes de ir</p>
            <div class="fact-grid">
              <div><span>Entrada</span><strong>Libre</strong></div>
              <div><span>Visita recomendada</span><strong>06:00–21:00</strong></div>
              <div><span>Tiempo sugerido</span><strong>45–90 min</strong></div>
              <div><span>Clima</span><strong>Altura andina</strong></div>
            </div>
            <p class="fine-print">El horario 06:00–21:00 corresponde a la franja de visita recomendada por MINCETUR, no a un cierre físico del espacio público.</p>
          </aside>
        </div>
        <div class="hero-credit">Fotografía histórica: <a href="https://commons.wikimedia.org/wiki/File:Plaza_Mayor_de_Huamanga_(25646832758).jpg">EduardoZambrano</a> · <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a> · 2017-12-26. Encuadre adaptado.</div>
      </section>

      <section class="intro-strip">
        <div class="shell intro-grid">
          <div class="intro-number"><span>111</span><small>columnas y arcos según MINCETUR</small></div>
          <p>Los cuatro frentes —Unión, Constitución, Independencia y Municipal— forman una secuencia de piedra que define la imagen del centro histórico. En el centro, el monumento ecuestre a Antonio José de Sucre articula jardines y fuentes simétricas.</p>
          <a href={minceturUrl} target="_blank" rel="noreferrer">Ver ficha de MINCETUR ↗</a>
        </div>
      </section>

      <section id="sobre" class="section entity-section" aria-labelledby="sobre-titulo">
        <div class="shell entity-layout">
          <div class="entity-copy">
            <p class="section-kicker">Sobre el atractivo</p>
            <h2 id="sobre-titulo">Sobre la {attractionFullName}</h2>
            <p class="large-copy entity-equalizer">Para orientarte, toma el monumento a Sucre como referencia central y reconoce la fachada de la Catedral en el perímetro. Recorrer la plaza al aire libre es una visita distinta de entrar a templos y museos, que tienen condiciones propias.</p>
            <p>Esta guía, publicada en <strong>{siteDomain}</strong>, reúne información práctica de referencia para visitar el espacio: ubicación, mapa, horarios de visita recomendados, acceso libre, transporte desde el aeropuerto o terminal terrestre, servicios cercanos y contexto histórico básico.</p>
            <p>Datos revisados el 29 de octubre de 2026. Google Maps mostraba 4,5/5 con 19.802 reseñas de terceros; esta valoración pertenece a su ficha y no a esta guía. MINCETUR y Maps tienen horarios con distinto alcance: compáralos antes de visitar.</p>
            <nav class="geo-breadcrumb" aria-label="Jerarquía geográfica del atractivo">
              <ol>
                <li><span>{attractionFullName}</span></li>
                <li aria-hidden="true">→</li>
                <li><span>{cityName}</span></li>
                <li aria-hidden="true">→</li>
                <li><span>Región de {stateProvince}</span></li>
                <li aria-hidden="true">→</li>
                <li><span>{countryName}</span></li>
              </ol>
            </nav>
            <p class="entity-cluster">Al visitar <strong>{attractionFullName}</strong> se pueden recorrer a pie hitos históricos vecinos como <strong>Basílica Catedral de Ayacucho</strong> y el <strong>Templo de Santo Domingo</strong>, además de portales, balcones y jardines que conforman el centro histórico de Huamanga.</p>
          </div>
          <figure class="entity-photo">
            <img src={photos.plaza} alt={`${attractionFullName} (${attractionLocalName}) — vista amplia con portales en ${cityName}, ${countryName}`} loading="lazy" />
            <figcaption><a href="https://commons.wikimedia.org/wiki/File:Plaza_Mayor_de_Huamanga_(25646832758).jpg">Plaza y portales · EduardoZambrano</a> · <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a> · 2017-12-26. Encuadre adaptado.</figcaption>
          </figure>
        </div>
      </section>

      <section id="historia" class="section section-stone">
        <div class="shell story-layout">
          <div class="story-copy">
            <p class="section-kicker">Huamanga en una sola plaza</p>
            <h2>Historia y significado de la {attractionFullName}</h2>
            <p class="section-lead">Una plaza construida para mirar en cuatro direcciones.</p>
            <p class="large-copy">La actual Ayacucho fue fundada como ciudad española en 1540. Con el tiempo, la plaza se consolidó como escenario cívico, religioso y cotidiano, enmarcado por arquitectura de los siglos XVI y XVII.</p>
            <p>Los portales de piedra en el primer nivel, los balcones de madera y los techos de teja roja crean una continuidad muy reconocible. La Catedral, la Municipalidad, la sede regional, la Corte y espacios universitarios refuerzan el papel de la plaza como centro institucional de la ciudad.</p>
            <div class="story-pills">
              <span>Arquitectura virreinal</span><span>Centro cívico</span><span>Semana Santa</span><span>Carnavales</span>
            </div>
          </div>
          <div class="photo-stack">
            <figure class="photo-main">
              <img src={photos.plaza} alt={`${attractionFullName} (${attractionLocalName}) — vista de los portales y monumento en ${cityName}, ${countryName}`} loading="lazy" />
              <figcaption><a href="https://commons.wikimedia.org/wiki/File:Plaza_Mayor_de_Huamanga_(25646832758).jpg">Plaza Mayor · EduardoZambrano</a> · <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a> · 2017-12-26. Encuadre adaptado.</figcaption>
            </figure>
            <figure class="photo-small">
              <img src={photos.monument} alt={`${attractionFullName} (${attractionLocalName}) — monumento ecuestre a Antonio José de Sucre en ${cityName}, ${countryName}`} loading="lazy" />
              <figcaption><a href="https://commons.wikimedia.org/wiki/File:Plaza_de_Armas_-_Ayacucho.JPG">Monumento a Sucre · Fer121</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · 2009-08-23. Encuadre adaptado.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="section arch-section">
        <div class="shell">
          <div class="section-heading split-heading">
            <div>
              <p class="section-kicker">Cómo vivirla</p>
              <h2>Tres momentos, tres plazas distintas</h2>
            </div>
            <p>La luz cambia la lectura de los arcos: piedra fría al amanecer, fachadas cálidas por la tarde y un centro cívico más animado al caer la noche.</p>
          </div>
          <div class="moment-grid">
            <article><span class="moment-time">06:00–09:00</span><h3>Primera luz</h3><p>Ideal para fotografías limpias, caminar bajo los portales y escuchar el centro antes de que aumente el tránsito peatonal.</p></article>
            <article><span class="moment-time">15:30–18:00</span><h3>Piedra dorada</h3><p>La luz lateral realza balcones, arcos y la fachada de la Catedral. Es una buena franja para combinar plaza, café y museo.</p></article>
            <article><span class="moment-time">18:00–21:00</span><h3>Plaza nocturna</h3><p>El centro gana ambiente local y las fachadas iluminadas cambian la escala del conjunto. Manténgase atento a eventos y cierres temporales.</p></article>
          </div>
        </div>
      </section>

      <section id="planifica" class="section section-dark">
        <div class="shell">
          <div class="section-heading light-heading">
            <p class="section-kicker">Planifica sin sorpresas</p>
            <h2>Lo práctico, antes de caminar por los portales</h2>
          </div>
          <div class="planning-grid">
            <article class="planning-card">
              <span class="icon-badge">S/</span>
              <h3>Entrada / costo</h3>
              <p><strong>Ingreso libre.</strong> La plaza no exige entrada según el inventario turístico oficial. Museos, templos con visitas especiales o actividades privadas pueden cobrar por separado.</p>
            </article>
            <article class="planning-card">
              <span class="icon-badge">◷</span>
              <h3>Horario</h3>
              <p>MINCETUR registra la <strong>visita recomendada de 06:00 a 21:00</strong> durante todo el año. Google Maps mostraba apertura el viernes a las 08:00 en la consulta del 29 de octubre de 2026. Son fuentes de distinto alcance: ninguna permite prometer acceso sin restricciones por actos, obras o medidas locales.</p>
            </article>
            <article class="planning-card">
              <span class="icon-badge">☀</span>
              <h3>Mejor época</h3>
              <p>Se puede visitar todo el año. En altura, el sol puede sentirse fuerte al mediodía y la temperatura bajar rápido por la tarde; lleve protección solar y una capa ligera.</p>
            </article>
            <article class="planning-card">
              <span class="icon-badge">↔</span>
              <h3>Duración</h3>
              <p><strong>45–90 minutos</strong> para la plaza sola. Reserve 2–3 horas si suma Catedral, Santo Domingo, arte popular y una comida en el casco histórico.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="transporte" class="section section-paper">
        <div class="shell transport-layout">
          <div>
            <p class="section-kicker">Transporte detallado</p>
            <h2>El centro histórico es el destino, no solo una parada</h2>
            <p class="large-copy">Al llegar al centro, lo más cómodo es terminar el trayecto a pie. Varias calles alrededor de la plaza pueden tener control vehicular durante celebraciones, desfiles o montajes.</p>
          </div>
          <div class="route-list">
            <article>
              <span class="route-index">01</span>
              <div><h3>Desde el aeropuerto</h3><p>Aeropuerto Coronel FAP Alfredo Mendívil Duarte → Plaza Mayor: <strong>aprox. 2,8 km</strong>. MINCETUR usa una referencia de <strong>7 min en taxi</strong> en condiciones favorables.</p></div>
            </article>
            <article>
              <span class="route-index">02</span>
              <div><h3>Desde el terminal terrestre</h3><p>Terminal Terrestre Los Libertadores → Plaza Mayor: <strong>aprox. 3,6 km</strong>, con referencia oficial de <strong>12 min en taxi</strong>. El tráfico puede ampliar el tiempo.</p></div>
            </article>
            <article>
              <span class="route-index">03</span>
              <div><h3>Desde el centro</h3><p>Si ya está en el casco histórico, priorice caminar. La plaza funciona como punto de orientación para restaurantes, templos, agencias y comercios tradicionales.</p></div>
            </article>
          </div>
        </div>
      </section>

      <section id="estacionamiento" class="section parking-section"><div class="shell"><p class="section-kicker">Estacionamiento</p><h2>Confirme dónde dejar el vehículo</h2><p>MINCETUR registra servicios de estacionamiento en la ciudad, no una plaza garantizada junto al recurso. No se ha verificado una cochera concreta, sus tarifas ni cupos; consulte directamente y revise restricciones de circulación antes de conducir al centro.</p></div></section>

      <section id="alrededores" class="section section-green">
        <div class="shell">
          <div class="section-heading light-heading split-heading">
            <div><p class="section-kicker">Alrededores</p><h2>Monumentos y atractivos alrededor de la {attractionShortName}</h2></div>
            <p>Qué ver sin alejarse de la plaza: arquitectura religiosa, arte popular y calles históricas caben en una ruta a pie desde la {attractionShortName}.</p>
          </div>
          <div class="nearby-grid">
            <article><span>En la plaza</span><h3>Basílica Catedral de Ayacucho</h3><p>La gran fachada religiosa del conjunto. Observe su relación con los portales y la escala abierta de la plaza.</p></article>
            <article><span>Recorrido urbano separado</span><h3>Templo de Santo Domingo</h3><p>Uno de los templos históricos más reconocibles del centro, asociado al paisaje religioso de Huamanga.</p></article>
            <article><span>Recorrido urbano separado</span><h3>Arco del Triunfo</h3><p>Hito del recorrido urbano de Ayacucho; comprueba la ruta y las condiciones de paso antes de continuar.</p></article>
            <article><span>Visita cultural separada</span><h3>Museo de Arte Popular Joaquín López Antay</h3><p>Sunarp lo menciona entre las referencias patrimoniales de Ayacucho; confirme su sede y operación actuales antes de organizar la visita.</p></article>
          </div>

          <div class="food-heading">
            <p class="section-kicker">Servicios alrededor</p>
            <h2>Qué tipo de servicios buscar en el entorno</h2>
          </div>
          <div class="food-grid">
            <article class="food-card featured-food"><div><span>Portales de la plaza</span><h3>Cafeterías y desayunos</h3></div><p>En los portales y calles inmediatas suele haber opciones para desayunar, tomar café o hacer una pausa corta con vista al conjunto monumental.</p></article>
            <article class="food-card"><div><span>Centro histórico</span><h3>Restaurantes de cocina regional</h3></div><p>En el entorno de la plaza es posible encontrar restaurantes y menús de comida ayacuchana. Conviene revisar carta, horario y afluencia el mismo día.</p></article>
            <article class="food-card"><div><span>Calles cercanas</span><h3>Hoteles y servicios turísticos</h3></div><p>El casco histórico concentra hospedajes, agencias y comercios de apoyo para continuar la visita a pie sin alejarse demasiado del centro.</p></article>
          </div>
          <p class="data-note">Siguiendo un criterio informativo e independiente, esta web describe tipos de servicios y no recomienda comercios concretos.</p>
        </div>
      </section>

      <section id="que-hacer" class="section section-dark">
        <div class="shell">
          <div class="section-heading light-heading">
            <p class="section-kicker">Cómo vivirla</p>
            <h2>Qué hacer en la {attractionShortName}</h2>
            <p>La plaza se disfruta mejor como una caminata lenta. Estas sugerencias caben en 45–90 minutos o en una mañana completa si suma los templos y museos vecinos.</p>
          </div>
          <div class="planning-grid">
            <article class="planning-card">
              <span class="icon-badge">▣</span>
              <h3>Fotografiar los portales</h3>
              <p>Los cuatro frentes —Unión, Constitución, Independencia y Municipal— ofrecen arcos, balcones de madera y teja roja. La luz dorada de la tarde realza la piedra y la fachada de la Catedral.</p>
            </article>
            <article class="planning-card">
              <span class="icon-badge">⛪</span>
              <h3>Visitar la Catedral y Santo Domingo</h3>
              <p>La Catedral y Santo Domingo son visitas distintas del espacio público de la plaza; compruebe el acceso y las condiciones de cada templo.</p>
            </article>
            <article class="planning-card">
              <span class="icon-badge">◫</span>
              <h3>Retablos y arte popular</h3>
              <p>El Museo de Arte Popular Joaquín López Antay es una visita cultural separada. Confirme su sede y funcionamiento actuales antes de organizar el recorrido.</p>
            </article>
            <article class="planning-card">
              <span class="icon-badge">☕</span>
              <h3>Café y gastronomía en los portales</h3>
              <p>Los portales concentran restaurantes y cafeterías con vista al conjunto monumental. Es una pausa cómoda entre la caminata y la visita a los templos.</p>
            </article>
          </div>
          <p class="data-note">Durante la Semana Santa de Ayacucho (marzo/abril) la plaza y el centro histórico reciben procesiones y mayor afluencia; espere controles de tránsito y horarios especiales.</p>
        </div>
      </section>

      <section id="lugares" class="section section-green">
        <div class="shell">
          <div class="section-heading light-heading split-heading">
            <div><p class="section-kicker">Más allá de la plaza</p><h2>Lugares turísticos en {cityName}</h2></div>
            <p>La {attractionShortName} es el punto de partida ideal para recorrer la ciudad. Distingue los recorridos urbanos de Wari y Quinua, que requieren organizar una excursión y transporte por separado.</p>
          </div>
          <div class="nearby-grid">
            <article><span>Mirador</span><h3>Mirador de Ayacucho</h3><p>Punto panorámico para ver la ciudad y el contorno de cerros que rodea la plaza y el centro.</p></article>
            <article><span>Excursión regional</span><h3>Complejo Arqueológico de Wari</h3><p>Conjunto arqueológico fuera del centro urbano; reserva transporte, tiempo y verifica el acceso actual por separado.</p></article>
            <article><span>Excursión regional</span><h3>Pueblo de Quinua</h3><p>Destino alfarero y visita regional separada del centro de Ayacucho; organiza transporte y consulta el acceso a cada lugar.</p></article>
          </div>
          <p class="data-note">Organiza por separado los desplazamientos urbanos y las excursiones; comprueba el acceso, el transporte y el tiempo disponible antes de salir.</p>
        </div>
      </section>

      <section class="section photo-section">
        <div class="shell photo-layout">
          <figure class="cathedral-photo">
            <img src={photos.cathedral} alt={`Basílica Catedral de Ayacucho junto a ${attractionShortName} (${attractionLocalName}) en ${cityName}, ${countryName}`} loading="lazy" />
            <figcaption><a href="https://commons.wikimedia.org/wiki/File:Catedral_de_Ayacucho_(25646655978).jpg">Catedral · EduardoZambrano</a> · <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a> · 2017-12-26. Encuadre adaptado.</figcaption>
          </figure>
          <div class="photo-copy">
            <p class="section-kicker">Detalle que vale la pena buscar</p>
            <h2>Balcones, tejas y torres de la {attractionFullName}</h2>
            <p>La plaza se entiende mejor cuando no se mira solo el jardín. Recorra los portales, observe el encuentro entre piedra y madera y use la Catedral como referencia para leer la composición urbana.</p>
            <blockquote>“La visita funciona mejor como una caminata lenta: cuatro lados, cuatro perspectivas y muchas capas de historia.”</blockquote>
          </div>
        </div>
      </section>

      <section id="mapa" class="section map-section">
        <div class="shell">
          <div class="section-heading split-heading">
            <div><p class="section-kicker">Ubicación</p><h2>Ubicación y cómo visitar la {attractionFullName}</h2><p class="map-address">{attractionFullName} ({attractionLocalName}) · {cityName} {postalCode}, {countryName}</p></div>
            <a class="text-link" href={mapUrl} target="_blank" rel="noreferrer">Abrir mapa completo ↗</a>
          </div>
          <div class="map-frame">
            <iframe
              title={`Mapa de ${attractionFullName} en ${cityName}`}
              src="https://maps.google.com/maps?q=-13.1603789,-74.2257816&amp;z=17&amp;output=embed&amp;hl=es"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
          <p class="official-note">
            Para información turística de referencia y material institucional, consulta{' '}
            <a href={minceturUrl} target="_blank" rel="noopener noreferrer">MINCETUR ↗</a>,{' '}
            <a href={promperuUrl} target="_blank" rel="noopener noreferrer">Perú Travel / PROMPERÚ ↗</a>.
          </p>
        </div>
      </section>

      <section id="faq" class="section faq-section">
        <div class="shell faq-layout">
          <div class="faq-intro">
            <p class="section-kicker">Preguntas frecuentes</p>
            <h2>Preguntas frecuentes sobre la {attractionFullName}</h2>
            <p>Para horarios sujetos a cambio, cierres por eventos y servicios privados, confirme la información antes de desplazarse.</p>
          </div>
          <div class="faq-list">
            {faq.map((item) => (
              <details>
                <summary><span>{item.q}</span><b>+</b></summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="fuentes" class="source-band">
        <div class="shell source-grid">
          <div><p class="section-kicker">Fuentes y orientación</p><h2>Fuentes públicas y fecha de consulta</h2></div>
          <div class="source-links">
            <a href={minceturUrl} target="_blank" rel="noreferrer"><strong>MINCETUR</strong><span>Inventario de recursos turísticos</span></a>
            <a href={promperuUrl} target="_blank" rel="noreferrer"><strong>Perú Travel / PROMPERÚ</strong><span>Contexto turístico de Ayacucho</span></a>
            <a href={commonsUrl} target="_blank" rel="noreferrer"><strong>Wikimedia Commons</strong><span>Fotografías documentales con licencia libre</span></a>
            <a href="https://cader.sunarp.gob.pe/ayacucho/" target="_blank" rel="noreferrer"><strong>Sunarp · Ayacucho</strong><span>Descripción patrimonial; confirma por separado la sede y operación de cada museo</span></a>
          </div>
          <p class="source-review">Consulta: 29 de octubre de 2026. MINCETUR distingue el espacio público y sus servicios externos; museos, templos y actividades tienen condiciones propias. Los tiempos de taxi de la ficha son orientativos.</p>
        </div>
      </section>
    </main>

