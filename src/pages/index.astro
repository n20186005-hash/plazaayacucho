---
import '../styles/global.css';
import { site, guides, guideGroups } from '../data/site.mjs';

const origin = Astro.site ? Astro.site.origin : 'https://plazaayacucho.com';
const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site).toString() : `${origin}${pathname}`;

const siteDomain = 'plazaayacucho.com';
const attractionFullName = 'Plaza Mayor de Ayacucho';
const attractionShortName = 'Plaza Mayor de Ayacucho';
const attractionLocalName = 'Plaza Mayor de Huamanga';
const cityName = 'Ayacucho';
const stateProvince = 'Ayacucho';
const countryName = 'Perú';
const countryCode = 'PE';
const postalCode = '05003';
const mapsPhone = '+51 985 928 260';
const mapsPhoneHref = '+51985928260';
const mapsRating = '4.5';
const mapsReviews = '19,804';
const mapsPlaceType = 'Parque urbano';
const mapsPlusCode = 'RQQF+RM, Ayacucho, Perú';
const latitude = -13.1603789;
const longitude = -74.2257816;

const mapUrl = 'https://maps.app.goo.gl/LoXftb7yUhBJUgCr9';
const minceturUrl = 'https://consultasenlinea.mincetur.gob.pe/fichaInventario/index.aspx?cod_Ficha=386';
const promperuUrl = 'https://target2.promperu.gob.pe/destinos/ayacucho/ciudad-de-ayacucho/plaza-mayor-de-la-ciudad-de-ayacucho';
const commonsUrl = 'https://commons.wikimedia.org/wiki/Ayacucho';

const localHero = `${origin}/images/plaza-mayor-huamanga-wide.jpg`;
const localPlaza = `${origin}/images/plaza-mayor-huamanga-wide.jpg`;
const localCathedral = `${origin}/images/catedral-ayacucho.jpg`;
const ogImage = localHero;
const ogImageAlt = `${attractionFullName} (${attractionLocalName}) — vista principal en ${cityName}, ${countryName}`;

const pageTitle = 'Plaza de Armas de Ayacucho, Ayacucho: guía turística';
const pageDescription = 'Guía turística de la Plaza de Armas de Ayacucho o Plaza Mayor de Huamanga: ubicación, historia, portales, monumento a Sucre, mapa y consejos de visita en Ayacucho, Perú.';

const photos = {
  hero: '/images/plaza-mayor-huamanga-wide.jpg',
  plaza: '/images/plaza-mayor-huamanga-wide.jpg',
  cathedral: '/images/catedral-ayacucho.jpg',
  monument: '/images/plaza-armas-monumento.jpg'
};

const faq = [
  {
    q: '¿La Plaza Mayor de Huamanga cobra entrada?',
    a: 'No. La ficha de inventario turístico de MINCETUR registra el ingreso como libre. Las iglesias, museos o actividades cercanas pueden tener condiciones propias.'
  },
  {
    q: '¿Cuál es el mejor horario para visitar la plaza?',
    a: 'MINCETUR recomienda la visita entre las 06:00 y las 21:00 durante todo el año. Para fotografía y una caminata más tranquila, la primera hora de la mañana y el final de la tarde suelen ser las franjas más agradables.'
  },
  {
    q: '¿Cuánto tiempo conviene quedarse?',
    a: 'Para recorrer la plaza, observar sus portales y hacer fotografías, reserve aproximadamente 45–90 minutos. Si añade la Catedral, Santo Domingo, museos y una comida en el centro histórico, conviene dedicar 2–3 horas o más.'
  },
  {
    q: '¿Cómo llego desde el aeropuerto de Ayacucho?',
    a: 'La ficha oficial de MINCETUR indica aproximadamente 2,8 km desde el Aeropuerto Coronel FAP Alfredo Mendívil Duarte, con una referencia de unos 7 minutos en taxi, una estimación de la ficha y no una duración garantizada.'
  },
  {
    q: '¿Hay estacionamiento dentro de la Plaza Mayor?',
    a: 'No cuente con un cupo junto a la plaza sin confirmarlo. MINCETUR registra estacionamiento en la ciudad; no se ha verificado aquí una cochera concreta, sus tarifas ni disponibilidad.'
  },
  {
    q: '¿Por qué también se llama Plaza Mayor de Huamanga?',
    a: 'MINCETUR denomina al recurso Plaza Mayor de Ayacucho y explica sus nombres históricos Plaza Mayor de Huamanga y Plaza de Armas. Las tres expresiones ayudan a identificar el mismo espacio, no tres plazas distintas.'
  },
  {
    q: `¿Dónde se ubica exactamente ${attractionFullName}?`,
    a: `${attractionFullName} se ubica en el centro histórico de ${cityName}, región ${stateProvince}, ${countryName}, con código postal ${postalCode}. Sus coordenadas aproximadas son ${latitude}, ${longitude}.`
  },
  {
    q: `¿Qué relación tiene plazaayacucho.com con ${attractionShortName}?`,
    a: `plazaayacucho.com es una guía informativa e independiente dedicada a ${attractionFullName} (${attractionLocalName}). Esta web no representa a ninguna entidad pública y atribuye sus datos a las fuentes consultadas; para condiciones actuales remite a los canales oficiales.`
  },
  {
    q: `¿Qué hacer en la ${attractionShortName}?`,
    a: `Camine bajo los cuatro portales (Unión, Constitución, Independencia y Municipal), fotografíe los balcones de madera y la fachada de la Catedral, recorra los jardines y el monumento a Sucre, y visite el Templo de Santo Domingo y el Museo de Arte Popular Joaquín López Antay (retablos ayacuchanos). Los portales también concentran cafés y restaurantes para una pausa con vista al conjunto.`
  },
  {
    q: `¿Qué lugares turísticos hay cerca de la plaza en ${cityName}?`,
    a: `La Catedral está junto a la plaza y Santo Domingo y el Arco del Triunfo son visitas urbanas separadas. Wari y Quinua corresponden a excursiones regionales: organiza transporte y tiempo por separado, sin presentarlas como un paseo a pie desde la plaza.`
  },
  {
    q: `¿Cuándo se celebra la Semana Santa de ${cityName}?`,
    a: `Ayacucho es reconocida por su Semana Santa, una de las más famosas del Perú, que se celebra en marzo o abril (fechas móviles según el calendario litúrgico). Las procesiones suelen partir de la Catedral y recorrer el centro histórico. Si visita la plaza en esas fechas, espere mayor afluencia, controles de tránsito y horarios especiales; conviene confirmar el programa oficial antes de ir.`
  },
  {
    q: `¿Cómo llegar a la ${attractionShortName}?`,
    a: `En taxi desde el Aeropuerto Coronel FAP Alfredo Mendívil Duarte son aprox. 2,8 km (unos 7 min en condiciones favorables, según MINCETUR); desde el Terminal Terrestre Los Libertadores, aprox. 3,6 km (unos 12 min). Si ya está en el casco histórico, lo mejor es caminar: la plaza funciona como punto de orientación para templos, restaurantes y comercios.`
  },
  {
    q: `¿Qué es la ${attractionLocalName}?`,
    a: `${attractionLocalName} es la forma histórica con la que también se identifica a la ${attractionShortName}. Huamanga fue el nombre histórico de la ciudad antes de denominarse Ayacucho, de modo que ambas expresiones pueden aparecer juntas en material turístico y patrimonial.`
  },
  { q: '¿Qué datos muestra la ficha de Google Maps?', a: `La ficha compartida de Google Maps muestra Plaza de Armas of Ayacucho, ${mapsRating}/5, ${mapsReviews} reseñas de terceros, la categoría ${mapsPlaceType}, Ayacucho ${postalCode}, Perú, el plus code ${mapsPlusCode} y el teléfono ${mapsPhone}. No se ha confirmado aquí que ese teléfono corresponda a la administración de la plaza ni que la categoría describa por completo el uso patrimonial del lugar.` }
];

const attractionLd = {
  '@context': 'https://schema.org',
  "@type": 'TouristAttraction',
  "@id": `${origin}/#attraction`,
  name: attractionFullName,
  alternateName: [attractionLocalName, 'Plaza de Armas de Ayacucho', `${cityName} ${attractionFullName}`],
  description: `Guía completa del visitante de ${attractionFullName} (${attractionLocalName}) en ${cityName}, ${stateProvince}, ${countryName}.`,
  url: canonical || origin,
  mainEntityOfPage: { "@type": 'WebPage', "@id": canonical || origin },
  image: [localHero, localPlaza, localCathedral],
  "isAccessibleForFree": true,
  priceRange: 'Ingreso libre',
  address: {
    "@type": 'PostalAddress',
    streetAddress: attractionFullName,
    addressLocality: cityName,
    addressRegion: stateProvince,
    postalCode,
    addressCountry: countryCode
  },
  geo: {
    "@type": 'GeoCoordinates',
    latitude,
    longitude
  },
  "hasMap": mapUrl,
  sameAs: [mapUrl, minceturUrl, promperuUrl, commonsUrl],
  containedInPlace: {
    "@type": 'City',
    name: cityName,
    containedInPlace: {
      "@type": 'AdministrativeArea',
      name: stateProvince,
      containedInPlace: { "@type": 'Country', name: countryName }
    }
  }
};

const faqLd = {
  '@context': 'https://schema.org',
  "@type": 'FAQPage',
  mainEntity: faq.map((item) => ({
    "@type": 'Question',
    name: item.q,
    acceptedAnswer: {
      "@type": 'Answer',
      text: item.a
    }
  }))
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  "@type": 'BreadcrumbList',
  itemListElement: [{ "@type": 'ListItem', position: 1, name: attractionFullName, item: origin }]
};
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#6f2e25" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-PE" href={origin + '/'} />
    <link rel="alternate" hreflang="x-default" href={origin + '/'} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Plaza Ayacucho" />
    <meta name="application-name" content="Plaza Ayacucho" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icons/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:site_name" content="Plaza Ayacucho" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={`${attractionShortName} (${attractionLocalName}) — qué hacer, cómo llegar e historia en ${cityName}`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${attractionShortName} (${attractionLocalName}) — guía en ${cityName}, ${countryName}`} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a href="#inicio" class="brand" aria-label={`Inicio — ${attractionFullName} (${attractionLocalName})`}>
          <img src="/icons/logo.svg" alt={`${attractionFullName} (${attractionLocalName})`} width="186" height="52" />
          <span class="brand-name"><b>{attractionFullName}</b><small>{attractionLocalName} · {cityName}, {countryName}</small></span>
        </a>
        <nav class="main-nav" aria-label="Navegación principal">
          <a href="#sobre">Sobre</a>
          <a href="/guias/">Guías</a>
          <a href="#historia">Historia</a>
          <a href="#planifica">Planifica</a>
          <a href="#que-hacer">Qué hacer</a>
          <a href="#alrededores">Alrededores</a>
          <a href="#lugares">Lugares</a>
          <a href="#mapa">Mapa</a>
          <a href="#faq">FAQ</a>
        </nav>
        <a class="map-button" href={mapUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
      </div>
    </header>

    <main id="contenido">
      <section id="inicio" class="hero" style={`--hero-image: url('${photos.hero}')`}>
        <div class="hero-overlay"></div>
        <div class="shell hero-layout">
          <div class="hero-copy">
            <div class="eyebrow-row">
              <span>Ayacucho · Perú</span>
              <span>2.752 m s. n. m.</span>
              <span>Maps {mapsRating} · {mapsReviews}</span>
              <span>Visita recomendada 06:00–21:00</span>
              <span>Centro histórico de Huamanga</span>
            </div>
            <p class="hero-kicker">{attractionFullName}</p>
            <h1>Plaza de Armas de Ayacucho <span class="h1-sub">({attractionLocalName}, {cityName})</span></h1>
            <p class="hero-tagline">El corazón de piedra, arcos y memoria de Ayacucho</p>
            <p class="hero-lead">Bienvenido a <strong>{attractionFullName}</strong>, también identificada históricamente como <strong>{attractionLocalName}</strong>. Situada en el corazón de <strong>{cityName}</strong>, <strong>Región de {stateProvince}</strong>, <strong>{countryName}</strong>, esta plaza es el punto de partida principal para explorar la ciudad y su centro histórico.</p>
            <div class="hero-actions">
              <a class="button button-gold" href="#planifica">Planificar visita</a>
              <a class="button button-ghost" href={mapUrl} target="_blank" rel="noreferrer">Ver ubicación en el mapa ↗</a>
              <a class="button button-ghost" href="#fuentes">Ver fuentes de la guía</a>
            </div>
          </div>

          <aside class="fact-card" aria-label="Datos rápidos">
            <p class="card-label">Antes de ir</p>
            <div class="fact-grid">
              <div><span>Entrada</span><strong>Libre</strong></div>
              <div><span>Visita recomendada</span><strong>06:00–21:00</strong></div>
              <div><span>Tiempo sugerido</span><strong>45–90 min</strong></div>
              <div><span>Clima</span><strong>Altura andina</strong></div>
            </div>
            <p class="fine-print">El horario 06:00–21:00 corresponde a la franja de visita recomendada por MINCETUR, no a un cierre físico del espacio público.</p>
          </aside>
        </div>
        <div class="hero-credit">Fotografía histórica: <a href="https://commons.wikimedia.org/wiki/File:Plaza_Mayor_de_Huamanga_(25646832758).jpg">EduardoZambrano</a> · <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a> · 2017-12-26. Encuadre adaptado.</div>
      </section>

      <section class="intro-strip">
        <div class="shell intro-grid">
          <div class="intro-number"><span>111</span><small>columnas y arcos según MINCETUR</small></div>
          <p>Los cuatro frentes —Unión, Constitución, Independencia y Municipal— forman una secuencia de piedra que define la imagen del centro histórico. En el centro, el monumento ecuestre a Antonio José de Sucre articula jardines y fuentes simétricas.</p>
          <a href={minceturUrl} target="_blank" rel="noreferrer">Ver ficha de MINCETUR ↗</a>
        </div>
      </section>

      <section id="consejos" class="section section-stone">
        <div class="shell">
          <div class="section-heading">
            <p class="section-kicker">Consejos de visita</p>
            <h2>Cómo aprovechar la Plaza Mayor</h2>
          </div>
          <ul class="checklist">
            <li>Camina los cuatro portales —Unión, Constitución, Independencia y Municipal— en lugar de mirar la plaza desde un solo lado.</li>
            <li>Elige la primera hora de la mañana o el final de la tarde: la luz lateral realza la piedra y los balcones de madera.</li>
            <li>Toma el monumento a Sucre como referencia central para orientarte y describir el recorrido.</li>
            <li>Trata templos y museos como visitas aparte: el espacio público de la plaza es libre, los recintos tienen condiciones propias.</li>
          </ul>

          <div class="section-heading" style="margin-top:64px">
            <p class="section-kicker">Lo más destacado</p>
            <h2>Qué define a este conjunto</h2>
          </div>
          <div class="info-grid">
            <article class="info-card">
              <span class="info-tag">Arquitectura</span>
              <h3>Cuatro portales de piedra</h3>
              <p>Una secuencia de arcos, balcones de madera y teja de arcilla que enmarca el conjunto y define la imagen del centro histórico. MINCETUR cuenta alrededor de 111 arcos y columnas.</p>
            </article>
            <article class="info-card">
              <span class="info-tag">Pieza central</span>
              <h3>Monumento a Sucre</h3>
              <p>La escultura ecuestre a Antonio José de Sucre ocupa el cruce de los ejes que unen los portales y funciona como referencia y punto de encuentro.</p>
            </article>
            <article class="info-card">
              <span class="info-tag">Entorno</span>
              <h3>Centro cívico y religioso</h3>
              <p>La fachada de la Catedral, la Municipalidad y otros edificios institucionales refuerzan el papel de la plaza como corazón de la ciudad.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="sobre" class="section entity-section" aria-labelledby="sobre-titulo">
        <div class="shell entity-layout">
          <div class="entity-copy">
            <p class="section-kicker">Sobre el atractivo</p>
            <h2 id="sobre-titulo">Sobre la {attractionFullName}</h2>
            <p class="large-copy entity-equalizer">Para orientarte, toma el monumento a Sucre como referencia central y reconoce la fachada de la Catedral en el perímetro. Recorrer la plaza al aire libre es una visita distinta de entrar a templos y museos, que tienen condiciones propias.</p>
            <p>Esta guía, publicada en <strong>{siteDomain}</strong>, reúne información práctica de referencia para visitar el espacio: ubicación, mapa, horarios de visita recomendados, acceso libre, transporte desde el aeropuerto o terminal terrestre, servicios cercanos y contexto histórico básico.</p>
            <p>La ficha compartida de Google Maps muestra {mapsRating}/5 con {mapsReviews} reseñas de terceros y la categoría <strong>{mapsPlaceType}</strong>; esa valoración pertenece a Google Maps y no a esta guía. Compárala con MINCETUR y con las condiciones reales del día antes de visitar.</p>
            <nav class="geo-breadcrumb" aria-label="Jerarquía geográfica del atractivo">
              <ol>
                <li><span>{attractionFullName}</span></li>
                <li aria-hidden="true">→</li>
                <li><span>{cityName}</span></li>
                <li aria-hidden="true">→</li>
                <li><span>Región de {stateProvince}</span></li>
                <li aria-hidden="true">→</li>
                <li><span>{countryName}</span></li>
              </ol>
            </nav>
            <p class="entity-cluster">Al visitar <strong>{attractionFullName}</strong> se pueden recorrer a pie hitos históricos vecinos como <strong>Basílica Catedral de Ayacucho</strong> y el <strong>Templo de Santo Domingo</strong>, además de portales, balcones y jardines que conforman el centro histórico de Huamanga.</p>
          </div>
          <figure class="entity-photo">
            <img src={photos.plaza} alt={`${attractionFullName} (${attractionLocalName}) — vista amplia con portales en ${cityName}, ${countryName}`} loading="lazy" />
            <figcaption><a href="https://commons.wikimedia.org/wiki/File:Plaza_Mayor_de_Huamanga_(25646832758).jpg">Plaza y portales · EduardoZambrano</a> · <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a> · 2017-12-26. Encuadre adaptado.</figcaption>
          </figure>
        </div>
      </section>

      <section id="ficha" class="section">
        <div class="shell">
          <div class="section-heading">
            <p class="section-kicker">Ficha rápida</p>
            <h2>Datos básicos de la {attractionFullName}</h2>
          </div>
          <table class="fact-table">
            <caption>Ficha rápida de la plaza</caption>
            <tbody>
              <tr><th>Nombre según MINCETUR</th><td><strong>{attractionFullName}</strong></td></tr>
              <tr><th>Otros nombres</th><td>Plaza de Armas de Ayacucho · {attractionLocalName}</td></tr>
              <tr><th>Ubicación</th><td>Centro histórico de {cityName}, Región de {stateProvince}, {countryName} · {postalCode}</td></tr>
              <tr><th>Entrada</th><td><strong>Libre</strong> al espacio público de la plaza (MINCETUR).</td></tr>
              <tr><th>Visita recomendada</th><td><strong>06:00–21:00</strong> durante todo el año (franja orientativa de MINCETUR).</td></tr>
              <tr><th>Duración sugerida</th><td>45–90 minutos para la plaza; 2–3 horas si sumas templos y museos.</td></tr>
              <tr><th>Portales</th><td>Unión, Constitución, Independencia y Municipal.</td></tr>
              <tr><th>Monumento central</th><td>Escultura ecuestre a Antonio José de Sucre, con inauguración en 1924.</td></tr>
            </tbody>
          </table>
          <p class="verify-note">Datos atribuidos al inventario de recursos turísticos de MINCETUR, enlazado al final de la página. Los horarios y condiciones de templos y museos son independientes y deben confirmarse con cada recinto.</p>
        </div>
      </section>

      <section id="historia" class="section section-stone">
        <div class="shell story-layout">
          <div class="story-copy">
            <p class="section-kicker">Huamanga en una sola plaza</p>
            <h2>Historia y significado de la {attractionFullName}</h2>
            <p class="section-lead">Una plaza construida para mirar en cuatro direcciones.</p>
            <p class="large-copy">La actual Ayacucho fue fundada como ciudad española en 1540. Con el tiempo, la plaza se consolidó como escenario cívico, religioso y cotidiano, enmarcado por arquitectura de los siglos XVI y XVII.</p>
            <p>Los portales de piedra en el primer nivel, los balcones de madera y los techos de teja roja crean una continuidad muy reconocible. La Catedral, la Municipalidad, la sede regional, la Corte y espacios universitarios refuerzan el papel de la plaza como centro institucional de la ciudad.</p>
            <div class="story-pills">
              <span>Arquitectura virreinal</span><span>Centro cívico</span><span>Semana Santa</span><span>Carnavales</span>
            </div>
          </div>
          <div class="photo-stack">
            <figure class="photo-main">
              <img src={photos.plaza} alt={`${attractionFullName} (${attractionLocalName}) — vista de los portales y monumento en ${cityName}, ${countryName}`} loading="lazy" />
              <figcaption><a href="https://commons.wikimedia.org/wiki/File:Plaza_Mayor_de_Huamanga_(25646832758).jpg">Plaza Mayor · EduardoZambrano</a> · <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a> · 2017-12-26. Encuadre adaptado.</figcaption>
            </figure>
            <figure class="photo-small">
              <img src={photos.monument} alt={`${attractionFullName} (${attractionLocalName}) — monumento ecuestre a Antonio José de Sucre en ${cityName}, ${countryName}`} loading="lazy" />
              <figcaption><a href="https://commons.wikimedia.org/wiki/File:Plaza_de_Armas_-_Ayacucho.JPG">Monumento a Sucre · Fer121</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · 2009-08-23. Encuadre adaptado.</figcaption>
            </figure>
          </div>
        </div>
      </section>

